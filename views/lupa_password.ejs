<!doctype html>
<html>
<head><%- include('partials/head', { title: 'Lupa Password' }) %></head>
<body class="login">
  <div class="wrapper">
    <h1><a href="/"><%= appShort %></a></h1>
    <div class="login-body">
      <h2>Reset Password</h2>
      <% if (info) { %><div class="alert alert-info"><%= info %></div><% } %>
      <form action="/lupa-password" method="post">
        <div class="form-group">
          <input type="text" name="email" placeholder="Email terdaftar" class="form-control">
        </div>
        <div class="forget">
          <input type="submit" value="Kirim Token" class="btn-primary btn-block btn btn-large">
        </div>
        <div style="text-align:center;margin-top:10px;"><a href="/login" style="font-size:12px;color:#888;">Kembali ke login</a></div>
      </form>
    </div>
  </div>
</body>
</html>
