<%- include('partials/open', { judul: 'Detail Mahasiswa', subjudul: mhs.nama }) %>
<div class="widget">
  <div class="widget-head">Biodata</div>
  <div class="widget-body">
    <table class="table">
      <tr><th style="width:200px">NIM</th><td><%= mhs.nim %></td></tr>
      <tr><th>Nama</th><td><%= mhs.nama %></td></tr>
      <tr><th>Program Studi</th><td><%= mhs.prodi %></td></tr>
      <tr><th>Angkatan</th><td><%= mhs.angkatan %></td></tr>
      <tr><th>NIK</th><td><%= mhs.nik %></td></tr>
      <tr><th>No. HP</th><td><%= mhs.no_hp %></td></tr>
      <tr><th>Alamat</th><td><%= mhs.alamat %></td></tr>
      <tr><th>IPK</th><td><%= mhs.ipk %></td></tr>
    </table>
    <a href="/transkrip?nim=<%= mhs.nim %>" class="btn btn-primary">Lihat Transkrip</a>
  </div>
</div>
<%- include('partials/close') %>
