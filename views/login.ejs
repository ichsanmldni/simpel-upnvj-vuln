<!doctype html>
<html>

    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
        <!-- Apple devices fullscreen -->
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="mobile-web-app-capable" content="yes" />
        <!-- Apple devices fullscreen -->
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
        <title>SIM UPN Veteran Jakarta - <%= typeof title !== 'undefined' ? title : 'Login' %></title>
        <!-- Bootstrap -->
        <link rel="stylesheet" href="/themes/css/bootstrap.min.css">
        <!-- icheck -->
        <link rel="stylesheet" href="/themes/css/plugins/icheck/all.css">
        <!-- Theme CSS -->
        <link rel="stylesheet" href="/themes/css/style.css?v=1.0.0">
        <!-- Color CSS -->
        <link rel="stylesheet" href="/themes/css/themes.css">
        <link rel="stylesheet" href="/themes/css/custom.css">
        <!-- jQuery -->
        <script src="/themes/js/jquery.min.js"></script>

        <!-- Nice Scroll -->
        <script src="/themes/js/plugins/nicescroll/jquery.nicescroll.min.js"></script>
        <!-- Validation -->
        <script src="/themes/js/plugins/validation/jquery.validate.min.js"></script>
        <script src="/themes/js/plugins/validation/additional-methods.min.js"></script>
        <!-- icheck -->
        <script src="/themes/js/plugins/icheck/jquery.icheck.min.js"></script>
        <!-- Bootstrap -->
        <script src="/themes/js/bootstrap.min.js"></script>
        <script src="/themes/js/eakroko.js?v=1.0.0"></script>
        <!-- Favicon -->
        <link rel="shortcut icon" href="/themes/img/favicon.ico" />
        <!-- Apple devices Homescreen icon -->
        <link rel="apple-touch-icon-precomposed" href="/themes/img/apple-touch-icon-precomposed.png" />
    </head>
    <body class='login'>
        <div class="wrapper">
            <h1>
                <a href="/">
                    Sistem Informasi Proses Pembelajaran
                </a>
            </h1>
            <div class="login-body">
                <h2>Halaman Login</h2>
                <form action="/login" method="post" class="form-validate" id="test">
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger"><%= error %></div>
                <% } %>
                    <div class="form-group">
                        <div class="email controls">
                            <input type="text" name='username' placeholder="Username" class='form-control' data-rule-required="true" autocomplete="username">
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="pw controls">
                            <input type="password" name="password" placeholder="Password" class='form-control' data-rule-required="true" autocomplete="current-password">
                        </div>
                    </div>
                    <div class="submit">
                        <div class="remember">
                            <input type="checkbox" name="remember" class='icheck-me' data-skin="square" data-color="blue" id="remember">
                            <label for="remember">Remember me</label>
                        </div>
                    </div>
                    <div class="forget" style="padding-bottom:0px;">
                        <input type="submit" value="Login" class='btn-primary btn-block btn btn-large'>
                    </div>
                   <div style="text-align:center;margin-bottom:8px;margin-top:8px;">
                        <span style="display:inline-block;width:40%;height:1px;background:#ccc;vertical-align:middle;"></span>
                        <span style="padding:0 8px;color:#888;font-size:12px;">or</span>
                        <span style="display:inline-block;width:40%;height:1px;background:#ccc;vertical-align:middle;"></span>
                    </div>

                    <div class="forget" style="margin-top:0px;">
                        <a href="/auth-sso" class="btn btn-success btn--icon btn-block btn-large">
                            Login with OneUPNVJ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </body>
</html>
