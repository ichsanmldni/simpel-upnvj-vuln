<%- include('partials/open', { judul: 'Mata Kuliah', subjudul: 'Daftar mata kuliah dan bobot SKS' }) %>
<div class="widget">
  <div class="widget-head">Kurikulum</div>
  <div class="widget-body">
    <table class="table table-striped table-bordered">
      <thead><tr><th>Kode</th><th>Nama</th><th>SKS</th><th>Semester</th><th>Prodi</th></tr></thead>
      <tbody>
      <% rows.forEach(function(m){ %>
        <tr><td><%= m.kode %></td><td><%= m.nama %></td><td><%= m.sks %></td><td><%= m.semester %></td><td><%= m.prodi %></td></tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('partials/close') %>
