<div class="container-fluid hidden-xs" id="logo-header">
  <a href="/" class="inline logo">
    <div class="headtitle"><%= appName %><br><span><%= univ %></span></div>
  </a>
</div>
<div id="navigation">
  <div class="container-fluid">
    <a href="/" class="visible-xs" id="brand"><%= appShort %></a>
    <ul id="main-nav">
      <li<%= path === '/dashboard' ? ' class="active"' : '' %>><a href="/dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
      <li<%= path.indexOf('/mahasiswa') === 0 ? ' class="active"' : '' %>><a href="/mahasiswa"><i class="fa fa-users"></i> Mahasiswa</a></li>
      <li<%= path === '/matakuliah' ? ' class="active"' : '' %>><a href="/matakuliah"><i class="fa fa-book"></i> Mata Kuliah</a></li>
      <li<%= path === '/krs' ? ' class="active"' : '' %>><a href="/krs"><i class="fa fa-list-alt"></i> KRS &amp; Nilai</a></li>
      <li<%= path === '/transkrip' ? ' class="active"' : '' %>><a href="/transkrip"><i class="fa fa-graduation-cap"></i> Transkrip</a></li>
      <li<%= path.indexOf('/pengumuman') === 0 ? ' class="active"' : '' %>><a href="/pengumuman"><i class="fa fa-bullhorn"></i> Pengumuman</a></li>
      <li<%= path === '/berkas' ? ' class="active"' : '' %>><a href="/berkas"><i class="fa fa-folder-open"></i> Berkas</a></li>
      <li<%= path.indexOf('/admin') === 0 ? ' class="active"' : '' %>><a href="/admin"><i class="fa fa-cogs"></i> Administrasi</a></li>
    </ul>
    <div class="user">
      <ul class="icon-nav show">
        <li class="dropdown">
          <a href="#" class="dropdown-toggle" data-toggle="dropdown">
            <i class="fa fa-user"></i> <%= user ? user.username : '' %> <span class="caret"></span>
          </a>
          <ul class="dropdown-menu pull-right">
            <li><a href="/profil"><i class="fa fa-id-card"></i> Profil Saya</a></li>
            <li><a href="/logout"><i class="fa fa-sign-out"></i> Keluar</a></li>
          </ul>
        </li>
      </ul>
    </div>
  </div>
</div>
