<%- include('partials/open', { judul: 'Log Aktivitas', subjudul: 'Jejak aktivitas pengguna sistem' }) %>
<div class="widget"><div class="widget-body">
  <form method="get" action="/admin/log" class="form-inline">
    <input type="text" name="user" class="form-control" placeholder="Username" value="<%= user %>">
    <button class="btn btn-primary">Filter</button>
  </form>
</div></div>
<div class="widget">
  <div class="widget-head">Log (<%= rows.length %>)</div>
  <div class="widget-body">
    <table class="table table-striped table-bordered">
      <thead><tr><th>Waktu</th><th>Pengguna</th><th>Aksi</th><th>IP</th></tr></thead>
      <tbody><% rows.forEach(function(l){ %><tr><td><%= l.waktu %></td><td><%= l.username %></td><td><%= l.aksi %></td><td><%= l.ip %></td></tr><% }) %></tbody>
    </table>
  </div>
</div>
<%- include('partials/close') %>
